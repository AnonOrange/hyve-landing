# --- Resend (email for report form) ---
# Sign up free at https://resend.com → API Keys → Create Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- APK Download URL ---
# Upload the APK to Supabase Storage, GitHub Releases, etc., then paste the URL here.
# Example: https://your-bucket.supabase.co/storage/v1/object/public/releases/hyve-beta.apk
NEXT_PUBLIC_APK_URL=https://your-apk-url-here

# --- Hyve CaseLine ---
# Stripe price IDs for the two CaseLine subscription tiers ($999/yr STARTER, $1799/yr FIRM).
# Create the products & prices in Stripe Dashboard → Products, then paste the price_ IDs here.
STRIPE_CASELINE_5_PRICE_ID=price_REPLACE_ME_5seat
STRIPE_CASELINE_10_PRICE_ID=price_REPLACE_ME_10seat

# Public installer URLs surfaced on /caseline/download. Upload signed installers
# to Supabase Storage, GitHub Releases, or any CDN, then paste the URLs here.
NEXT_PUBLIC_CASELINE_WIN_URL=https://your-storage/caseline-latest.msi
NEXT_PUBLIC_CASELINE_MAC_URL=https://your-storage/caseline-latest.dmg
NEXT_PUBLIC_CASELINE_LINUX_URL=https://your-storage/caseline-latest.AppImage

# Optional: separate download for the CaseLine Server (on-prem hub).
NEXT_PUBLIC_CASELINE_SERVER_URL=
