# --- Resend (email for report form) ---
# Sign up free at https://resend.com → API Keys → Create Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- APK Download URL ---
# Upload the APK to Supabase Storage, GitHub Releases, etc., then paste the URL here.
# Example: https://your-bucket.supabase.co/storage/v1/object/public/releases/hyve-beta.apk
NEXT_PUBLIC_APK_URL=https://your-apk-url-here

# --- Hyve CaseLine ---
# Stripe price IDs for the two CaseLine subscription tiers ($999/yr STARTER, $1799/yr FIRM).
# Create the products & prices in Stripe Dashboard → Products, then paste the price_ IDs here.
STRIPE_CASELINE_5_PRICE_ID=price_REPLACE_ME_5seat
STRIPE_CASELINE_10_PRICE_ID=price_REPLACE_ME_10seat

# Public installer URLs surfaced on /caseline/download. Upload signed installers
# to Supabase Storage, GitHub Releases, or any CDN, then paste the URLs here.
NEXT_PUBLIC_CASELINE_WIN_URL=https://your-storage/caseline-latest.msi
NEXT_PUBLIC_CASELINE_MAC_URL=https://your-storage/caseline-latest.dmg
NEXT_PUBLIC_CASELINE_LINUX_URL=https://your-storage/caseline-latest.AppImage

# Optional: separate download for the CaseLine Server (on-prem hub).
NEXT_PUBLIC_CASELINE_SERVER_URL=

# --- HYVE Attend (Supabase Auth for the /attend product) ---
# The browser-side Supabase Auth client needs the project URL and anon key
# exposed to the client. Set these to the SAME values as the server-side
# SUPABASE_URL / SUPABASE_ANON_KEY already in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe webhook signing secret for the Attend webhook endpoint
# (/api/attend/webhooks/stripe). Create that endpoint in Stripe Dashboard
# -> Developers -> Webhooks, then paste its signing secret here.
STRIPE_ATTEND_WEBHOOK_SECRET=whsec_...

# Bearer token the scheduled jobs (GitHub Actions cron) send to the Attend job
# endpoints, e.g. /api/attend/jobs/cart-expiry. Use any long random string.
ATTEND_CRON_SECRET=replace-with-a-long-random-string

# Mux Live — the /attend live-streaming integration. Create an API access
# token in the Mux Dashboard -> Settings -> Access Tokens. Without these the
# fake stream provider is used (dev/CI). MUX_WEBHOOK_SECRET is the signing
# secret of the /api/attend/webhooks/mux endpoint.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
